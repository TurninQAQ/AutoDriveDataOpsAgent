#!/usr/bin/env bash
set -euo pipefail

SOURCE_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
RUNTIME_PATH_FILE="$SOURCE_DIR/runtime.path"

error() {
    echo "[ERROR] $*" >&2
    exit 1
}

if [ ! -f "$RUNTIME_PATH_FILE" ]; then
    error "runtime.path not found: $RUNTIME_PATH_FILE"
fi

resolve_runtime_dir() {
    local value line key path host_ips
    host_ips="$(hostname -I 2>/dev/null | tr ' ' '\n' | sed '/^[[:space:]]*$/d' | tr '\n' ' ')"
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"
        line="$(printf '%s' "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [ -n "$line" ] || continue

        if [[ "$line" == *"="* ]]; then
            key="$(printf '%s' "${line%%=*}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
            path="$(printf '%s' "${line#*=}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
            [ -n "$key" ] || continue
            [ -n "$path" ] || continue
            [[ "$key" == "default" || "$key" == "*" ]] && error "runtime.path 不支持 default 兜底配置，请为当前机器 IP 显式配置运行目录: $RUNTIME_PATH_FILE"
            case " $host_ips " in
                *" $key "*) value="$path"; break ;;
            esac
        else
            error "runtime.path 只支持 <机器IP>=<运行目录> 格式，非法行: $line"
        fi
    done < "$RUNTIME_PATH_FILE"
    printf '%s\n' "${value:-}"
}

RUNTIME_DIR=$(resolve_runtime_dir)
if [ -z "${RUNTIME_DIR:-}" ]; then
    host_ips="$(hostname -I 2>/dev/null | tr ' ' '\n' | sed '/^[[:space:]]*$/d' | tr '\n' ' ')"
    error "runtime.path 未配置当前机器 IP 对应运行目录. current_ips=[$host_ips] file=$RUNTIME_PATH_FILE"
fi

case "$RUNTIME_DIR" in
    "~"*) RUNTIME_DIR="${HOME}${RUNTIME_DIR#\~}" ;;
esac

RUNTIME_TASK="$RUNTIME_DIR/bin/task"

if [ ! -f "$RUNTIME_DIR/.deploy_ci_cloud_runtime" ]; then
    error "runtime marker not found: $RUNTIME_DIR/.deploy_ci_cloud_runtime. Run ./platform install first."
fi

if [ ! -x "$RUNTIME_TASK" ]; then
    error "runtime task entry not found or not executable: $RUNTIME_TASK. Run ./platform install/deploy first."
fi

case "${1:-}" in
    -h|--help|help)
        ;;
    *)
        echo "[INFO] runtime_dir=$RUNTIME_DIR" >&2
        echo "[INFO] forward_to=$RUNTIME_TASK" >&2
        ;;
esac
export AIRFLOW_TASK_COMMAND="${AIRFLOW_TASK_COMMAND:-$0}"
exec "$RUNTIME_TASK" "$@"
