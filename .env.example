# Airflow 页面端口
AIRFLOW_PORT=8080

# Airflow 任务执行/心跳 API 端口，仅监听 127.0.0.1，默认使用 AIRFLOW_PORT+1。
AIRFLOW_EXECUTION_API_PORT=8081

# 可选：页面对外访问地址。为空时启动脚本会自动用 hostname -I 推断机器 IP。
# 示例：AIRFLOW_PUBLIC_URL=http://172.20.151.115:8080
AIRFLOW_PUBLIC_URL=

# 可选：Airflow 本机 API 地址。为空时自动使用 http://127.0.0.1:${AIRFLOW_PORT}
AIRFLOW_API_BASE=

# 可选：Airflow 任务执行/心跳 API 地址。为空时自动使用 http://127.0.0.1:${AIRFLOW_EXECUTION_API_PORT}
AIRFLOW_EXECUTION_API_BASE=

# 可选：Airflow 内部端口。同机多实例部署时需要和老平台错开。
AIRFLOW_WORKER_LOG_SERVER_PORT=8793
AIRFLOW_TRIGGER_LOG_SERVER_PORT=8794
AIRFLOW_SCHEDULER_HEALTH_CHECK_SERVER_PORT=8974

# 本机 PostgreSQL。安装前请确认数据库和用户已经创建。
AIRFLOW_DB_URI=postgresql+psycopg2://airflow:airflow_password@127.0.0.1:5432/airflow

# Airflow UI/API 登录账号。不是数据库账号。
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# =========================
# V0.2 本地 GPU/算法仿真
# =========================
# 生产环境保持 nvidia（默认）；无 GPU 的本地开发环境可设为 simulated。
PLATFORM_GPU_RUNTIME=nvidia
# PLATFORM_GPU_RUNTIME=simulated
# PLATFORM_GPU_SIM_CONFIG=/path/to/config/gpu_simulator.yaml
# PLATFORM_GPU_SIM_STATE=/tmp/deploy_ci_cloud/state/gpu_simulator.json
# PLATFORM_GPU_SIM_FALLBACK_OS_PROCESS=1

# 生产默认 real；本地可设为 mock，使 run_*.sh 使用 scripts/mock_stage.py。
PLATFORM_STAGE_RUNTIME=real
# MOCK_STAGE_RESULT=success
# MOCK_STAGE_DURATION_SEC=0
# 也可以按 Stage 覆盖，例如：
# MOCK_STAGE_RESULT_SEGMENT=oom
# MOCK_STAGE_DURATION_SEC_OD=10

# =========================
# Agent model provider
# =========================
# auto: prefer Qwen when DASHSCOPE_API_KEY/DASHSCOPE_OPENAI_BASE_URL is configured,
# then Gemini, then OpenAI-compatible, finally the deterministic heuristic model.
# Explicit values: qwen | gemini | openai | heuristic
PLATFORM_AGENT_PROVIDER=qwen

# Provider model.
PLATFORM_AGENT_MODEL=qwen-plus
PLATFORM_AGENT_TEMPERATURE=0

# Shared provider retry policy. PLATFORM_GEMINI_RETRY_* remains a compatibility fallback.
PLATFORM_MODEL_RETRY_ATTEMPTS=5
PLATFORM_MODEL_RETRY_BASE_SEC=1
PLATFORM_MODEL_RETRY_MAX_SEC=20
PLATFORM_MODEL_RETRY_JITTER_SEC=0.25

# Formal runtime uses LangGraph; sequential is for dependency-light regression/debug.
PLATFORM_AGENT_RUNTIME=langgraph
PLATFORM_AGENT_MAX_TOOL_CALLS=6
PLATFORM_AGENT_MAX_STEPS=8
PLATFORM_AGENT_MAX_IDENTICAL_TOOL_CALLS=2
PLATFORM_AGENT_MAX_CONSECUTIVE_TOOL_FAILURES=2
PLATFORM_AGENT_SESSION_DIR=

# Gemini Developer API. NEVER commit the real key.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Alibaba Cloud Bailian / DashScope Qwen runtime. NEVER commit the real key.
# DASHSCOPE_API_KEY=
# DASHSCOPE_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Optional Airflow runtime secrets. Leave blank to generate once into
# Runtime/config/runtime_secrets.env. Do not commit generated values.
# AIRFLOW_FERNET_KEY=
# AIRFLOW_API_SECRET_KEY=
# AIRFLOW_JWT_SECRET=

# OpenAI-compatible provider (optional alternative).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# V0.5 static knowledge / RAG
# Realtime task/GPU/container state still comes from MCP tools; these settings only control static docs/runbooks.
PLATFORM_AGENT_KNOWLEDGE_ENABLED=1
# Source checkout default: <repo>/knowledge; deployed runtime default: <runtime>/opt_airflow/knowledge
PLATFORM_AGENT_KNOWLEDGE_DIR=
# Persistent local index; default: $AIRFLOW_STATE_DIR/agent_knowledge/index.json
PLATFORM_AGENT_KNOWLEDGE_INDEX=
PLATFORM_AGENT_KNOWLEDGE_TOP_K=5
PLATFORM_AGENT_KNOWLEDGE_MIN_SCORE=0.08

# V1.3.1 Qwen dense RAG. Hash remains available for local baseline comparison.
PLATFORM_RAG_EMBED_PROVIDER=qwen
PLATFORM_RAG_EMBED_MODEL=qwen3.7-text-embedding
PLATFORM_RAG_EMBED_DIM=1024
PLATFORM_RAG_EMBED_BATCH_SIZE=20
PLATFORM_RAG_EMBED_INDEX=
PLATFORM_RAG_QWEN_INSTRUCT=
# Empty weights select 0.50/0.50 for real dense providers and 0.65/0.35 for hash.
PLATFORM_RAG_LEXICAL_WEIGHT=
PLATFORM_RAG_VECTOR_WEIGHT=

# =========================
# V0.6 Natural Language Task Planning
# =========================
# Deterministic platform defaults used after natural-language extraction.
# Empty means <runtime>/opt_airflow/config/task_planning_defaults.yaml after install/deploy.
PLATFORM_TASK_PLANNING_DEFAULTS=

# V0.7 HITL approval persistence. Empty uses $AIRFLOW_STATE_DIR/agent_approvals.
PLATFORM_AGENT_APPROVAL_DIR=
# Pending approval TTL in seconds. Expired approvals cannot execute.
PLATFORM_AGENT_APPROVAL_TTL_SEC=900

# V0.8 post-action verification. Write tool success is not treated as business success
# until deterministic task/queue/Docker/GPU/Airflow evidence satisfies the action contract.
PLATFORM_AGENT_VERIFY_ATTEMPTS=5
PLATFORM_AGENT_VERIFY_INTERVAL_SEC=1.0

# =========================
# V0.9 Evaluation + Observability
# =========================
# Persistent request/approval/verification traces. Disable only for constrained debugging.
PLATFORM_AGENT_TRACE_ENABLED=1
# Empty means $AIRFLOW_STATE_DIR/agent_traces
PLATFORM_AGENT_TRACE_DIR=
# Empty means $AIRFLOW_STATE_DIR/agent_audit/audit.jsonl
PLATFORM_AGENT_AUDIT_FILE=
# Maximum string length persisted for one trace value after secret redaction.
PLATFORM_AGENT_TRACE_MAX_VALUE_CHARS=16000
# V1.0 observability retention / rotation (0 disables an individual limit)
PLATFORM_AGENT_TRACE_RETENTION_DAYS=14
PLATFORM_AGENT_TRACE_MAX_FILES=5000
PLATFORM_AGENT_AUDIT_MAX_BYTES=20971520
PLATFORM_AGENT_AUDIT_BACKUP_COUNT=5

# V1.1 optional semantic/judge evaluation. Dependency-light eval-aligned does not need these.
# Set PLATFORM_INSTALL_EVAL_DEPS=1 before `./platform install` to install Ragas/DeepEval Python dependencies.
PLATFORM_INSTALL_EVAL_DEPS=0
# Empty provider auto-selects Gemini when GEMINI_API_KEY exists, else OpenAI.
# For V1.3.1 real Qwen judge evaluation use qwen and the DashScope-compatible endpoint.
PLATFORM_EVAL_PROVIDER=
# Gemini defaults: gemini-3.7-flash + gemini-embedding-2.
# Qwen defaults: qwen-plus + qwen3.7-text-embedding.
# OpenAI defaults: gpt-5-mini + text-embedding-3-small.
PLATFORM_EVAL_JUDGE_MODEL=
PLATFORM_EVAL_JUDGE_BASE_URL=
PLATFORM_EVAL_EMBED_MODEL=
# Bound Ragas' internal structured-Judge retry loop so metric timeouts remain effective.
PLATFORM_EVAL_RAGAS_MAX_RETRIES=1
# Optional checkpoint for preserving Agent/Retrieval samples before Judge scoring.
PLATFORM_EVAL_COLLECTION_ARTIFACT=
