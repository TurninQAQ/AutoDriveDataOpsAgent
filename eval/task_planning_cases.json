[
  {
    "id": "release_full_gpu_policy",
    "query": "创建一个release任务，把 /data/record_001 做完整流程，最多同时4个clip，segment和od独占GPU，occ共享GPU",
    "expected_valid": true,
    "expected": {
      "resolved_priority": 10,
      "priority_source": "task_type",
      "task_spec.max_active_runs": 4,
      "task_spec.exclusive_gpu_stages": "segment,od",
      "task_spec.datasets.0.dataset_path": "/data/record_001"
    }
  },
  {
    "id": "test_precheck_cpu_only",
    "query": "创建一个test任务，只运行 precheck，数据 /tmp/record_a",
    "expected_valid": true,
    "expected": {
      "resolved_priority": 50,
      "task_spec.gpu_stages": "",
      "task_spec.pipeline_stages": ["precheck"]
    }
  },
  {
    "id": "od_explicit_priority_memory",
    "query": "生成任务配置，任务名 debug_case，只运行 od，dataset /data/clip_001，优先级30，od 24GB",
    "expected_valid": true,
    "expected": {
      "resolved_priority": 30,
      "priority_source": "explicit",
      "task_spec.gpu_stage_memory_mb.od": 24576,
      "task_spec.datasets.0.dataset_name": "clip_001"
    }
  },
  {
    "id": "missing_dataset_path",
    "query": "创建一个release任务，完整流程",
    "expected_valid": false,
    "expected_unresolved": ["datasets.dataset_path"]
  },
  {
    "id": "parallel_pipeline_literal",
    "query": "生成任务配置，任务名 test_pipe，pipeline=precheck,parser,[od,occ],coloration，数据 /data/r2",
    "expected_valid": true,
    "expected": {
      "task_spec.pipeline_stages": ["precheck", "parser", ["od", "occ"], "coloration"],
      "task_spec.gpu_stages": "od,occ"
    }
  },
  {
    "id": "reprocess_priority_default",
    "query": "创建一个reprocess任务，只运行 parser，数据 /data/r3",
    "expected_valid": true,
    "expected": {
      "resolved_priority": 20,
      "priority_source": "task_type",
      "task_spec.task_prefix": "reprocess"
    }
  },
  {
    "id": "invalid_stage",
    "query": "生成任务配置，任务名 debug_bad，pipeline=unknown_stage，数据 /data/r4",
    "expected_valid": false
  },
  {
    "id": "two_clips_same_record",
    "query": "创建一个test任务，只运行 parser，clip_001 clip_002 数据 /data/record_shared",
    "expected_valid": true,
    "expected": {
      "task_spec.datasets.0.dataset_name": "clip_001",
      "task_spec.datasets.1.dataset_name": "clip_002",
      "task_spec.datasets.1.dataset_path": "/data/record_shared"
    }
  }
]
