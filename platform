install_venv() {
    if [ ! -x "$AIRFLOW_PYTHON" ]; then
        info "Creating Python venv: $RUNTIME_DIR/venv"
        python3 -m venv "$RUNTIME_DIR/venv"
    fi
    info "Installing Airflow requirements"
    "$AIRFLOW_PYTHON" -m pip install --upgrade pip
    "$AIRFLOW_PYTHON" -m pip install -r "$SOURCE_DIR/requirements-airflow.txt"
    if [ -f "$SOURCE_DIR/requirements-mcp.txt" ]; then
        info "Installing Platform MCP requirements"
        "$AIRFLOW_PYTHON" -m pip install -r "$SOURCE_DIR/requirements-mcp.txt"
    fi
    if [ -f "$SOURCE_DIR/requirements-agent.txt" ]; then
        info "Installing Agent runtime requirements"
        "$AIRFLOW_PYTHON" -m pip install -r "$SOURCE_DIR/requirements-agent.txt"
    fi
    if [ "${PLATFORM_INSTALL_EVAL_DEPS:-0}" = "1" ] && [ -f "$SOURCE_DIR/requirements-eval.txt" ]; then
        info "Installing optional V1.1 evaluation framework requirements"
        "$AIRFLOW_PYTHON" -m pip install -r "$SOURCE_DIR/requirements-eval.txt"
    fi
}

write_password_file() {
    "$AIRFLOW_PYTHON" - "$AIRFLOW_PASSWORD_FILE" "$AIRFLOW_ADMIN_USER" "$AIRFLOW_ADMIN_PASSWORD" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
user = sys.argv[2]
password = sys.argv[3]
path.parent.mkdir(parents=True, exist_ok=True)
path.write_text(json.dumps({user: password}, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
PY
    chmod 600 "$AIRFLOW_PASSWORD_FILE"
}

render_airflow_cfg() {
    local base_cfg="$SOURCE_DIR/config/airflow.cfg.base"
    [ -f "$base_cfg" ] || error "airflow cfg base not found: $base_cfg"
    load_runtime_secrets
    set_airflow_api_defaults
    mkdir -p "$AIRFLOW_HOME"
    cp -f "$base_cfg" "$AIRFLOW_HOME/airflow.cfg"
    "$AIRFLOW_PYTHON" - "$AIRFLOW_HOME/airflow.cfg" \
        "$AIRFLOW_DAGS_FOLDER" \
        "$AIRFLOW_HOME/plugins" \
        "$AIRFLOW_HOME/logs" \
        "$AIRFLOW_HOME/logs/dag_processor" \
        "$AIRFLOW_DB_URI" \
        "$AIRFLOW_PORT" \
        "$AIRFLOW_ADMIN_USER" \
        "$AIRFLOW_PASSWORD_FILE" \
        "$AIRFLOW_API_BASE" \
        "$AIRFLOW__CORE__EXECUTION_API_SERVER_URL" \
        "$AIRFLOW_WORKER_LOG_SERVER_PORT" \
        "$AIRFLOW_TRIGGER_LOG_SERVER_PORT" \
        "$AIRFLOW_SCHEDULER_HEALTH_CHECK_SERVER_PORT" \
        "$AIRFLOW_FERNET_KEY" \
        "$AIRFLOW_API_SECRET_KEY" \
        "$AIRFLOW_JWT_SECRET" <<'PY'
import sys
from pathlib import Path

cfg = Path(sys.argv[1])
values = {
    ("core", "dags_folder"): sys.argv[2],
    ("core", "plugins_folder"): sys.argv[3],
    ("core", "simple_auth_manager_users"): f"{sys.argv[8]}:Admin",
    ("core", "simple_auth_manager_passwords_file"): sys.argv[9],
    ("core", "execution_api_server_url"): sys.argv[11],
    ("database", "sql_alchemy_conn"): sys.argv[6],
    ("logging", "base_log_folder"): sys.argv[4],
    ("logging", "dag_processor_child_process_log_directory"): sys.argv[5],
    ("logging", "worker_log_server_port"): sys.argv[12],
    ("logging", "trigger_log_server_port"): sys.argv[13],
    ("api", "port"): sys.argv[7],
    ("api", "base_url"): sys.argv[10],
    ("api_server", "port"): sys.argv[7],
    ("scheduler", "scheduler_health_check_server_port"): sys.argv[14],
    ("core", "fernet_key"): sys.argv[15],
    ("api", "secret_key"): sys.argv[16],
    ("api_auth", "jwt_secret"): sys.argv[17],
    ("webserver", "config_file"): str(Path(sys.argv[1]).parent / "webserver_config.py"),
}

required_existing = {
    ("core", "execution_api_server_url"),
    ("api", "port"),
    ("api", "base_url"),
    ("core", "fernet_key"),
    ("api", "secret_key"),
    ("api_auth", "jwt_secret"),
}
section = None
seen = set()
out = []


def append_missing_for_section(section_name):
    if section_name is None:
        return
    for (value_section, key), value in values.items():
        if value_section == section_name and (value_section, key) not in seen:
            if (value_section, key) in required_existing:
                continue
            out.append(f"{key} = {value}")
            seen.add((value_section, key))


for raw in cfg.read_text(encoding="utf-8").splitlines():
    stripped = raw.strip()
    if stripped.startswith("[") and stripped.endswith("]"):
        append_missing_for_section(section)
        section = stripped[1:-1]
        out.append(raw)
        continue
    if section is not None and "=" in raw and not stripped.startswith("#"):
        key = raw.split("=", 1)[0].strip()
        repl_key = (section, key)
        if repl_key in values:
            out.append(f"{key} = {values[repl_key]}")
            seen.add(repl_key)
            continue
    out.append(raw)

append_missing_for_section(section)

missing = sorted(required_existing - seen)
if missing:
    detail = ", ".join(f"[{section}] {key}" for section, key in missing)
    raise SystemExit(f"required airflow config key(s) missing: {detail}")

    cfg.write_text("\n".join(out) + "\n", encoding="utf-8")
PY
    chmod 600 "$AIRFLOW_HOME/airflow.cfg"
}

