#!/usr/bin/env bash
set -euo pipefail

SOURCE_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
RUNTIME_PATH_FILE="$SOURCE_DIR/runtime.path"
ENV_FILE="$SOURCE_DIR/.env"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info() { echo -e "${YELLOW}[INFO]${NC} $*"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*" >&2; exit 1; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*" >&2; }

usage() {
    cat <<'EOF'
平台命令 ./platform

日常更新代码:
  git pull --rebase
  ./platform deploy
  ./platform status
  $RUNTIME_DIR/bin/mcp-server   启动只读 MCP Server（stdio）
  $RUNTIME_DIR/bin/dataops-agent ask "为什么 task_A 没运行？"
  $RUNTIME_DIR/bin/dataops-agent plan-task "创建一个release任务，把 /data/record_001 做完整流程"

首次安装:
  vim runtime.path
  cp .env.example .env
  vim .env
  ./platform install
  ./platform start
  ./platform status

组件管理:
  ./platform start     启动缺失组件，不重启已运行组件
  ./platform stop      停止平台组件
  ./platform status    查看组件、健康状态和 Airflow 访问地址

部署/安装:
  ./platform install
  ./platform deploy

故障恢复:
  ./platform restart   会清 active/queued/scheduled 任务、任务容器和锁，然后重启组件

查看日志:
  tail -n 200 $RUNTIME_DIR/airflow/logs/scheduler.log
  tail -n 200 $RUNTIME_DIR/airflow/logs/dag_processor.log
  tail -n 200 $RUNTIME_DIR/airflow/logs/api_server.log
  tail -n 200 $RUNTIME_DIR/airflow/logs/execution_api_server.log
  tail -n 200 $RUNTIME_DIR/airflow/logs/task_submit_scheduler.log
  任务日志目录: $RUNTIME_DIR/airflow/logs/dag_id=batch_pipeline_universal_<task_name>/

说明:
  install 读取 runtime.path 和 .env，会生成 airflow.cfg、初始化 venv、应用 Airflow runtime 补丁并迁移数据库。
  deploy 只同步 DAG/scripts/platform_core/platform_mcp/platform_agent/platform_planning/platform_rag/knowledge/config 到 runtime，不改 airflow.cfg，不重启组件。
  start 只补齐缺失组件，restart 才会先清理任务状态再重启。
  任务操作请使用 ./task --help 查看。
  MCP Server 安装后使用 $RUNTIME_DIR/bin/mcp-server 启动。
  Agent 安装后使用 $RUNTIME_DIR/bin/dataops-agent ask/chat/plan-task。

帮助:
  ./platform --help
EOF
}

read_runtime_dir() {
    [ -f "$RUNTIME_PATH_FILE" ] || error "runtime.path not found: $RUNTIME_PATH_FILE"
    local value line key path host_ips
    host_ips="$(hostname -I 2>/dev/null | tr ' ' '\n' | sed '/^[[:space:]]*$/d' | tr '\n' ' ')"
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%%#*}"
        line="$(printf '%s' "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [ -n "$line" ] || continue

        if [[ "$line" == *"="* ]]; then
            key="$(printf '%s' "${line%%=*}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
            path="$(printf '%s' "${line#*=}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
            [ -n "$key" ] || continue
            [ -n "$path" ] || continue
            [[ "$key" == "default" || "$key" == "*" ]] && error "runtime.path 不支持 default 兜底配置，请为当前机器 IP 显式配置运行目录: $RUNTIME_PATH_FILE"
            case " $host_ips " in
                *" $key "*) value="$path"; break ;;
            esac
        else
            error "runtime.path 只支持 <机器IP>=<运行目录> 格式，非法行: $line"
        fi
    done < "$RUNTIME_PATH_FILE"
    [ -n "${value:-}" ] || error "runtime.path 未配置当前机器 IP 对应运行目录. current_ips=[$host_ips] file=$RUNTIME_PATH_FILE"
    case "$value" in
        "~"*) value="${HOME}${value#\~}" ;;
    esac
    RUNTIME_DIR="$value"
    AIRFLOW_HOME="$RUNTIME_DIR/airflow"
    AIRFLOW_DAGS_FOLDER="$AIRFLOW_HOME/dags"
    AIRFLOW_DAGS_DIR="$AIRFLOW_DAGS_FOLDER/data_center"
    AIRFLOW_SCRIPTS_DIR="$RUNTIME_DIR/opt_airflow/scripts"
    AIRFLOW_CONFIG_DIR="$RUNTIME_DIR/opt_airflow/config"
    AIRFLOW_TASK_CONFIG_ROOT="$AIRFLOW_CONFIG_DIR/tasks"
    AIRFLOW_HOST_DATA_ROOT="$RUNTIME_DIR/opt_airflow/data"
    AIRFLOW_TOOLS_DIR="$AIRFLOW_SCRIPTS_DIR/tools"
    AIRFLOW_GENERATED_DAGS_DIR="$AIRFLOW_DAGS_DIR/generated"
    AIRFLOW_TEMPLATE_DAGS_DIR="$AIRFLOW_DAGS_DIR/templates"
    AIRFLOW_BIN="$RUNTIME_DIR/venv/bin/airflow"
    AIRFLOW_PYTHON="$RUNTIME_DIR/venv/bin/python"
    AIRFLOW_PASSWORD_FILE="$AIRFLOW_HOME/simple_auth_manager_passwords.json.generated"
    RUNTIME_SECRETS_FILE="$RUNTIME_DIR/config/runtime_secrets.env"
    PLATFORM_HOME="$RUNTIME_DIR"
    AIRFLOW_STATE_DIR="$RUNTIME_DIR/state"
    AIRFLOW_TASK_QUEUE_DIR="$AIRFLOW_STATE_DIR/task_queue"
    AIRFLOW_TASK_LOCK_DIR="$AIRFLOW_STATE_DIR/task_locks"
    AIRFLOW_GPU_LOCK_DIR="$AIRFLOW_STATE_DIR/gpu_locks"
}

require_runtime_marker() {
