runtime_usage() {
    cat <<EOF_HELP
平台运行目录命令 $0

组件管理:
  $0 start     启动缺失组件，不重启已运行组件
  $0 stop      停止平台组件
  $0 status    查看组件、健康状态和 Airflow 访问地址

故障恢复:
  $0 restart   会清 active/queued/scheduled 任务、任务容器和锁，然后重启组件

查看日志:
  tail -n 200 $RUNTIME_DIR/airflow/logs/scheduler.log
  tail -n 200 $RUNTIME_DIR/airflow/logs/dag_processor.log
  tail -n 200 $RUNTIME_DIR/airflow/logs/api_server.log
  tail -n 200 $RUNTIME_DIR/airflow/logs/execution_api_server.log
  tail -n 200 $RUNTIME_DIR/airflow/logs/task_submit_scheduler.log
  任务日志目录: $RUNTIME_DIR/airflow/logs/dag_id=batch_pipeline_universal_<task_name>/

说明:
  install/deploy 必须在源码目录用 ./platform 执行。
  任务操作请使用 ./task --help 查看。

帮助:
  $0 --help
EOF_HELP
}

case "${1:-}" in
    start|status|stop)
        exec "$AIRFLOW_SCRIPTS_DIR/airflow_ctl.sh" "$@"
        ;;
    restart)
        "$AIRFLOW_SCRIPTS_DIR/airflow_ctl.sh" stop
        "$AIRFLOW_PYTHON" "$AIRFLOW_SCRIPTS_DIR/task_manager.py" restart-cleanup --yes \
            --dags-dir "$AIRFLOW_DAGS_DIR" \
            --task-config-root "$AIRFLOW_TASK_CONFIG_ROOT"
        exec "$AIRFLOW_SCRIPTS_DIR/airflow_ctl.sh" start
        ;;
    -h|--help|help)
        runtime_usage
        exit 0
        ;;
    *)
        runtime_usage >&2
        exit 2
        ;;
esac
EOF
    chmod +x "$RUNTIME_DIR/bin/platform"
}

check_active_tasks() {
    export_runtime_env
    if [ ! -x "$AIRFLOW_PYTHON" ]; then
        error "AIRFLOW_PYTHON not found: $AIRFLOW_PYTHON"
    fi
    local active_count
    active_count=$("$AIRFLOW_PYTHON" - <<'PY' | tail -n 1
import os
try:
    from airflow.models.dagrun import DagRun
    from airflow.utils.session import create_session
except Exception as exc:
    print(f"IMPORT_ERROR:{exc}")
    raise SystemExit(2)

with create_session() as session:
    count = session.query(DagRun).filter(DagRun.state.in_(("running", "queued"))).count()
print(count)
PY
)
    if [[ "$active_count" == IMPORT_ERROR:* ]]; then
        error "failed to inspect Airflow DagRuns: $active_count"
    fi
    if [ "${active_count:-0}" != "0" ]; then
        error "active Airflow DagRuns exist (running/queued=$active_count), refuse deploy"
    fi

    if command -v docker >/dev/null 2>&1; then
        local containers
        containers=$(docker ps --format '{{.Names}}' 2>/dev/null | grep -E '^(airflow-|airflow-task-)' || true)
        if [ -n "$containers" ]; then
            error "platform containers are still running, refuse deploy:
$containers"
        fi
    fi
}

cmd_install() {
    read_runtime_dir
    load_dot_env_for_install
    require_writable_runtime
    require_airflow_database
    create_runtime_dirs
    install_venv
    ensure_runtime_secrets
    apply_airflow_patches
    render_airflow_cfg
    write_password_file
    write_platform_env
    touch "$RUNTIME_DIR/.deploy_ci_cloud_runtime"
    export_runtime_env
    info "Running airflow db migrate"
    "$AIRFLOW_BIN" db migrate
    deploy_runtime_files
    write_runtime_bins
    success "install completed"
    echo "runtime_dir=$RUNTIME_DIR"
}

cmd_deploy() {
    read_runtime_dir
    require_runtime_marker
    load_platform_env
    load_runtime_secrets
    require_writable_runtime
    mkdir -p "$AIRFLOW_STATE_DIR" "$AIRFLOW_TASK_QUEUE_DIR" "$AIRFLOW_TASK_LOCK_DIR" "$AIRFLOW_GPU_LOCK_DIR"
    write_platform_env
    check_active_tasks
    deploy_runtime_files
    write_runtime_bins
    success "deploy completed"
}

cmd_start() {
    read_runtime_dir
    require_runtime_marker
    load_platform_env
    export_runtime_env
    bash "$AIRFLOW_SCRIPTS_DIR/airflow_ctl.sh" start
}

cmd_stop() {
    read_runtime_dir
    require_runtime_marker
    load_platform_env
    export_runtime_env
    bash "$AIRFLOW_SCRIPTS_DIR/airflow_ctl.sh" stop
}

cmd_restart() {
    read_runtime_dir
    require_runtime_marker
    load_platform_env
    export_runtime_env
    info "Restarting platform with task cleanup"
    bash "$AIRFLOW_SCRIPTS_DIR/airflow_ctl.sh" stop
    "$AIRFLOW_PYTHON" "$AIRFLOW_SCRIPTS_DIR/task_manager.py" restart-cleanup --yes \
        --dags-dir "$AIRFLOW_DAGS_DIR" \
        --task-config-root "$AIRFLOW_TASK_CONFIG_ROOT"
    bash "$AIRFLOW_SCRIPTS_DIR/airflow_ctl.sh" start
    success "restart completed"
}

cmd_status() {
    read_runtime_dir
    require_runtime_marker
    load_platform_env
    export_runtime_env
    echo "runtime_dir=$RUNTIME_DIR"
    echo "airflow_home=$AIRFLOW_HOME"
    echo "scripts_dir=$AIRFLOW_SCRIPTS_DIR"
    echo "config_dir=$AIRFLOW_CONFIG_DIR"
    df -h "$RUNTIME_DIR" || true
    bash "$AIRFLOW_SCRIPTS_DIR/airflow_ctl.sh" status
}

case "${1:-}" in
    install) cmd_install ;;
    deploy) cmd_deploy ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    status) cmd_status ;;
    -h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
esac
