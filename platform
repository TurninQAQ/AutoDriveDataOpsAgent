clear_install_airflow_env() {
    unset AIRFLOW_PORT
    unset AIRFLOW_PUBLIC_URL
    unset AIRFLOW_API_BASE
    unset AIRFLOW_EXECUTION_API_PORT
    unset AIRFLOW_EXECUTION_API_BASE
    unset AIRFLOW_WORKER_LOG_SERVER_PORT
    unset AIRFLOW_TRIGGER_LOG_SERVER_PORT
    unset AIRFLOW_SCHEDULER_HEALTH_CHECK_SERVER_PORT
    unset AIRFLOW_DB_URI
    unset AIRFLOW_ADMIN_USER
    unset AIRFLOW_ADMIN_PASSWORD
    unset AIRFLOW__API__BASE_URL
    unset AIRFLOW__CORE__EXECUTION_API_SERVER_URL
}

load_dot_env_for_install() {
    [ -f "$ENV_FILE" ] || error ".env not found. Run: cp .env.example .env && vim .env"
    clear_install_airflow_env
    # shellcheck disable=SC1090
    set -a
    source "$ENV_FILE"
    set +a
    AIRFLOW_PORT="${AIRFLOW_PORT:-8080}"
    AIRFLOW_PUBLIC_URL="${AIRFLOW_PUBLIC_URL:-}"
    AIRFLOW_WORKER_LOG_SERVER_PORT="${AIRFLOW_WORKER_LOG_SERVER_PORT:-8793}"
    AIRFLOW_TRIGGER_LOG_SERVER_PORT="${AIRFLOW_TRIGGER_LOG_SERVER_PORT:-8794}"
    AIRFLOW_SCHEDULER_HEALTH_CHECK_SERVER_PORT="${AIRFLOW_SCHEDULER_HEALTH_CHECK_SERVER_PORT:-8974}"
    AIRFLOW_EXECUTION_API_PORT="${AIRFLOW_EXECUTION_API_PORT:-$((AIRFLOW_PORT + 1))}"
    AIRFLOW_EXECUTION_API_BASE="${AIRFLOW_EXECUTION_API_BASE:-http://127.0.0.1:${AIRFLOW_EXECUTION_API_PORT}}"
    AIRFLOW_DB_URI="${AIRFLOW_DB_URI:-}"
    AIRFLOW_ADMIN_USER="${AIRFLOW_ADMIN_USER:-admin}"
    AIRFLOW_ADMIN_PASSWORD="${AIRFLOW_ADMIN_PASSWORD:-admin}"
    [ -n "$AIRFLOW_DB_URI" ] || error "AIRFLOW_DB_URI is empty in .env"
}

set_airflow_api_defaults() {
    AIRFLOW_API_BASE="${AIRFLOW_API_BASE:-http://127.0.0.1:${AIRFLOW_PORT}}"
    AIRFLOW_EXECUTION_API_PORT="${AIRFLOW_EXECUTION_API_PORT:-$((AIRFLOW_PORT + 1))}"
    AIRFLOW_EXECUTION_API_BASE="${AIRFLOW_EXECUTION_API_BASE:-http://127.0.0.1:${AIRFLOW_EXECUTION_API_PORT}}"
    AIRFLOW__API__BASE_URL="$AIRFLOW_API_BASE"
    AIRFLOW__CORE__EXECUTION_API_SERVER_URL="${AIRFLOW_EXECUTION_API_BASE%/}/execution/"
}

airflow_db_psql_uri() {
    python3 - "$AIRFLOW_DB_URI" <<'PY'
import sys
from urllib.parse import urlsplit, urlunsplit

uri = sys.argv[1]
parts = urlsplit(uri)
if not parts.scheme.startswith("postgresql"):
    raise SystemExit("AIRFLOW_DB_URI must use a postgresql scheme")
scheme = parts.scheme.split("+", 1)[0]
print(urlunsplit((scheme, parts.netloc, parts.path, parts.query, parts.fragment)))
PY
}

require_airflow_database() {
    command -v psql >/dev/null 2>&1 || error "psql not found. Install PostgreSQL client first."
    local psql_uri db_check_log detail
    psql_uri="$(airflow_db_psql_uri)" || error "AIRFLOW_DB_URI is invalid in .env"
    db_check_log="$(mktemp)"
    if ! psql "$psql_uri" -v ON_ERROR_STOP=1 -Atc "SELECT 1;" >/dev/null 2>"$db_check_log"; then
        detail="$(tr '\n' ' ' < "$db_check_log" | sed 's/[[:space:]][[:space:]]*/ /g')"
        rm -f "$db_check_log"
        error "Airflow database is not ready. Create the PostgreSQL role/database matching AIRFLOW_DB_URI before running ./platform install. Detail: $detail"
    fi
    rm -f "$db_check_log"
}

load_platform_env() {
    local platform_env="$RUNTIME_DIR/config/platform.env"
    [ -f "$platform_env" ] || error "runtime config not found: $platform_env. Run ./platform install first."
    # shellcheck disable=SC1090
    source "$platform_env"
}

load_runtime_secrets() {
    [ -f "$RUNTIME_SECRETS_FILE" ] || error "runtime secrets not found: $RUNTIME_SECRETS_FILE"
    # shellcheck disable=SC1090
    source "$RUNTIME_SECRETS_FILE"
    [ -n "${AIRFLOW_FERNET_KEY:-}" ] || error "AIRFLOW_FERNET_KEY is missing from $RUNTIME_SECRETS_FILE"
    [ -n "${AIRFLOW_API_SECRET_KEY:-}" ] || error "AIRFLOW_API_SECRET_KEY is missing from $RUNTIME_SECRETS_FILE"
    [ -n "${AIRFLOW_JWT_SECRET:-}" ] || error "AIRFLOW_JWT_SECRET is missing from $RUNTIME_SECRETS_FILE"
}

ensure_runtime_secrets() {
    mkdir -p "$(dirname "$RUNTIME_SECRETS_FILE")"
    "$AIRFLOW_PYTHON" "$SOURCE_DIR/scripts/runtime_secrets.py" ensure --path "$RUNTIME_SECRETS_FILE"
    load_runtime_secrets
}

