# Runtime configuration. Never commit actual credentials.
AUTODRIVE_ENVIRONMENT=development
AUTODRIVE_OPERATOR_ID=trusted-operator
AUTODRIVE_TRUST_DOMAIN=default-trust-domain
AUTODRIVE_PROVIDER=qwen
AUTODRIVE_MODEL=qwen-plus
AUTODRIVE_PROVIDER_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
AUTODRIVE_PROVIDER_API_KEY_ENV=DASHSCOPE_API_KEY
AUTODRIVE_PLATFORM_ENDPOINT=http://127.0.0.1:8765/mcp
AUTODRIVE_RUNTIME_ROOT=/home/ubuntu/project/autodrive_dataops_runtimev2
# DASHSCOPE_API_KEY is supplied by the host environment or secret manager.
